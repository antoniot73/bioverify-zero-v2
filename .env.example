APP_NAME=BioVerify-Zero
APP_ENV=development
APP_MODE=face_embedding_demo
LOG_LEVEL=INFO

MAX_IMAGE_BYTES=3145728
MAX_TOTAL_BODY_BYTES=8000000
MAX_IMAGE_SIDE=1280
NORMALIZED_FACE_SIZE=112

SIMILARITY_THRESHOLD=0.65
ALLOWED_ORIGINS=http://localhost:7860
DISABLE_BIOMETRIC_LOGGING=true

FACE_DETECTOR_MODE=yunet
FACE_EMBEDDING_MODE=sface
YUNET_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
SFACE_MODEL_PATH=models/face_recognition_sface_2021dec.onnx
YUNET_SCORE_THRESHOLD=0.85
YUNET_NMS_THRESHOLD=0.30
YUNET_TOP_K=5000
MIN_FACE_AREA_RATIO=0.015
MIN_BLUR_SCORE=18.0
MIN_BRIGHTNESS=35.0
MAX_BRIGHTNESS=225.0
